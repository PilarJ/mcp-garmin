# Public URL this server is reachable at, no trailing slash.
BASE_URL=https://mcp-garmin.example.com

# GitHub OAuth app used to authenticate MCP clients.
# Callback URL to register with GitHub: <BASE_URL>/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated GitHub logins allowed to use this server.
# Leave empty and the server refuses to start — this is the only thing
# standing between your health data and the public internet.
ALLOWED_GITHUB_LOGINS=

# Stable secret for signing the tokens issued to MCP clients. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Without it, every restart signs all clients out.
JWT_SIGNING_KEY=

# Where Garmin OAuth tokens are persisted (written by garmin-mcp-auth).
DATA_DIR=/data

# Optional: pre-fill the interactive login. Leave unset to be prompted.
# GARMIN_EMAIL=
# GARMIN_PASSWORD=

HOST=0.0.0.0
PORT=8000
